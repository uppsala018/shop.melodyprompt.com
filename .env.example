# ─── Stripe ──────────────────────────────────────────────────────────────────
# Re-use from main melodyprompt.com Vercel project
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — create these in your Stripe Dashboard
# (or run: pnpm seed-stripe)
STRIPE_PRICE_BOOK_01=price_...
STRIPE_PRICE_BOOK_02=price_...
STRIPE_PRICE_BOOK_03=price_...
STRIPE_PRICE_BOOK_04=price_...
STRIPE_PRICE_BOOK_05=price_...
STRIPE_PRICE_BOOK_06=price_...
STRIPE_PRICE_BOOK_07=price_...
STRIPE_PRICE_BOOK_08=price_...
STRIPE_PRICE_BOOK_09=price_...
STRIPE_PRICE_BOOK_10=price_...
STRIPE_PRICE_BUNDLE=price_...

# ─── Analytics ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ─── Launch promo ────────────────────────────────────────────────────────────
# ISO date when the launch sale ends (default: 30 days from build)
NEXT_PUBLIC_LAUNCH_END=2026-06-30

# ─── Vercel Blob ─────────────────────────────────────────────────────────────
# Populate after enabling Blob Storage in the Vercel project
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
